{:deps {io.github.borkdude/quickblog
        #_"You use the newest SHA here:"
        {:git/sha "6aa8fc35ea8563616b74255223f27b4f4d72f690"}}
 :tasks
 {:requires ([quickblog.cli :as cli]
             [selmer.filters :as filters])
  :init     (do (def month-names
                  ["janeiro" "fevereiro" "março" "abril" "maio" "junho"
                   "julho" "agosto" "setembro" "outubro" "novembro" "dezembro"])

                (defn long-date
                  "Formats a yyyy-MM-dd date string as \"15 de março de 2026\"."
                  [date]
                  (let [local-date (java.time.LocalDate/parse date)]
                    (str (.getDayOfMonth local-date)
                         " de " (nth month-names (dec (.getMonthValue local-date)))
                         " de " (.getYear local-date))))

                (filters/add-filter! :long-date long-date)

                (def opts {:blog-title       "Bruno Nascimento's blog"
                           :blog-description "A blog about Software Engineering and other stuff not related to programming"
                           :blog-root        "https://brunolab.dev.br"
                           :blog-author      "Bruno do Nascimento Maciel"
                           :favicon          true}))
  quickblog {:doc  "Start blogging quickly! Run `bb quickblog help` for details."
             :task (cli/dispatch opts)}}}
